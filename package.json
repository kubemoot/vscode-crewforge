{
  "name": "crewforge",
  "displayName": "CrewForge",
  "description": "See, ask, and deploy Kubemoot crews from VS Code, through your kubeconfig",
  "version": "0.0.0",
  "publisher": "kubemoot",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubemoot/vscode-crewforge"
  },
  "homepage": "https://kubemoot.org",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kubemoot",
    "kubernetes",
    "agents",
    "llm",
    "crew"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kubemoot",
          "title": "Kubemoot",
          "icon": "media/kubemoot.svg"
        }
      ]
    },
    "views": {
      "kubemoot": [
        {
          "id": "crewforge.crews",
          "name": "Deployed Crews"
        },
        {
          "id": "crewforge.sources",
          "name": "Crew Sources"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "crewforge.crews",
        "contents": "No deployed crews found in this context.\n[Select kubeconfig](command:crewforge.selectKubeconfig)\n[Select context](command:crewforge.selectContext)"
      },
      {
        "view": "crewforge.sources",
        "contents": "No crew charts or bundles found in this workspace.\n[Create Crew](command:crewforge.createCrew)\nOr right-click a folder in the Explorer and choose New Crew Here, or open a folder that holds a crew's Helm chart or manifests."
      }
    ],
    "commands": [
      {
        "command": "crewforge.refreshCrews",
        "title": "Refresh Deployed Crews",
        "category": "CrewForge",
        "icon": "$(refresh)"
      },
      {
        "command": "crewforge.askCrew",
        "title": "Ask Crew",
        "category": "CrewForge",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "crewforge.continueConversation",
        "title": "Continue a Conversation",
        "category": "CrewForge",
        "icon": "$(history)"
      },
      {
        "command": "crewforge.exportConversation",
        "title": "Export Conversation as Markdown",
        "category": "CrewForge"
      },
      {
        "command": "crewforge.askAboutSelection",
        "title": "Ask Crew about Selection",
        "category": "CrewForge"
      },
      {
        "command": "crewforge.selectContext",
        "title": "Select Kubernetes Context",
        "category": "CrewForge",
        "icon": "$(server-environment)"
      },
      {
        "command": "crewforge.selectKubeconfig",
        "title": "Select Kubeconfig File",
        "category": "CrewForge"
      },
      {
        "command": "crewforge.openConversationsFolder",
        "title": "Open Conversations Folder",
        "category": "CrewForge"
      },
      {
        "command": "crewforge.refreshSources",
        "title": "Refresh Crew Sources",
        "category": "CrewForge",
        "icon": "$(refresh)"
      },
      {
        "command": "crewforge.showDrift",
        "title": "Compare Source with Live (normalized diff)",
        "category": "CrewForge",
        "icon": "$(diff)"
      },
      {
        "command": "crewforge.deploySource",
        "title": "Deploy to a Namespace... (Helm, bundle, or Flux)",
        "category": "CrewForge",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "crewforge.updateDeployment",
        "title": "Redeploy from Source (helm upgrade or kubectl apply)",
        "category": "CrewForge",
        "icon": "$(sync)"
      },
      {
        "command": "crewforge.applyResource",
        "title": "Apply Only This Object (kubectl apply)",
        "category": "CrewForge",
        "icon": "$(arrow-up)"
      },
      {
        "command": "crewforge.removeDeployment",
        "title": "Undeploy (Remove Deployment)",
        "category": "CrewForge",
        "icon": "$(trash)"
      },
      {
        "command": "crewforge.createCrew",
        "title": "Create Crew (kmctl create)",
        "category": "CrewForge",
        "icon": "$(add)"
      },
      {
        "command": "crewforge.newCrewHere",
        "title": "New Crew Here",
        "category": "CrewForge",
        "icon": "$(add)"
      },
      {
        "command": "crewforge.lintCrew",
        "title": "Lint Crew (helm lint and schema check)",
        "category": "CrewForge",
        "icon": "$(checklist)"
      },
      {
        "command": "crewforge.deployDev",
        "title": "Deploy to Dev Namespace",
        "category": "CrewForge",
        "icon": "$(rocket)"
      },
      {
        "command": "crewforge.redeployDev",
        "title": "Redeploy to Dev Namespace (helm upgrade)",
        "category": "CrewForge",
        "icon": "$(sync)"
      },
      {
        "command": "crewforge.askSource",
        "title": "Ask Crew",
        "category": "CrewForge",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "crewforge.crewActions",
        "title": "Crew Actions (next steps)",
        "category": "CrewForge"
      },
      {
        "command": "crewforge.deployRevision",
        "title": "Deploy a Git Revision (Roll Back or Forward)",
        "category": "CrewForge",
        "icon": "$(history)"
      },
      {
        "command": "crewforge.runFitness",
        "title": "Run Fitness",
        "category": "CrewForge",
        "icon": "$(beaker)"
      },
      {
        "command": "crewforge.showRun",
        "title": "Show Fitness Run Report",
        "category": "CrewForge"
      },
      {
        "command": "crewforge.followRollout",
        "title": "Follow Flux Rollout (GitOps channel)",
        "category": "CrewForge",
        "icon": "$(eye)"
      },
      {
        "command": "crewforge.showLiveYaml",
        "title": "Show Live YAML",
        "category": "CrewForge",
        "icon": "$(cloud)"
      },
      {
        "command": "crewforge.showCrewBundleYaml",
        "title": "Show Crew Bundle YAML",
        "category": "CrewForge",
        "icon": "$(files)"
      },
      {
        "command": "crewforge.showSourceYaml",
        "title": "Show Source YAML (as rendered)",
        "category": "CrewForge",
        "icon": "$(file-code)"
      },
      {
        "command": "crewforge.showLiveYamlRaw",
        "title": "Show Live YAML (raw)",
        "category": "CrewForge",
        "icon": "$(file-binary)"
      },
      {
        "command": "crewforge.deleteSource",
        "title": "Delete Crew Source (move folder to trash)",
        "category": "CrewForge",
        "icon": "$(trash)"
      },
      {
        "command": "crewforge.renameCrew",
        "title": "Rename Crew",
        "category": "CrewForge",
        "icon": "$(edit)"
      },
      {
        "command": "crewforge.openCrewDashboard",
        "title": "Open Crew Dashboard",
        "category": "CrewForge",
        "icon": "$(dashboard)"
      },
      {
        "command": "crewforge.openCrewsOverview",
        "title": "Open Crews Overview",
        "category": "CrewForge",
        "icon": "$(dashboard)"
      },
      {
        "command": "crewforge.openFitnessDashboard",
        "title": "Open Fitness Dashboard",
        "category": "CrewForge",
        "icon": "$(pulse)"
      },
      {
        "command": "crewforge.showConnectionInfo",
        "title": "Show Connection Info",
        "category": "CrewForge",
        "icon": "$(plug)"
      },
      {
        "command": "crewforge.addScenario",
        "title": "Add Fitness Scenario (ADL or prose file)",
        "category": "CrewForge",
        "icon": "$(add)"
      },
      {
        "command": "crewforge.renameScenario",
        "title": "Rename Fitness Scenario",
        "category": "CrewForge",
        "icon": "$(edit)"
      },
      {
        "command": "crewforge.deleteScenario",
        "title": "Delete Fitness Scenario (to trash, or out of its suite)",
        "category": "CrewForge",
        "icon": "$(trash)"
      },
      {
        "command": "crewforge.runScenario",
        "title": "Run This Scenario Only (one iteration, dev namespace)",
        "category": "CrewForge",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "crewforge.refreshCrews",
          "when": "view == crewforge.crews",
          "group": "navigation@1"
        },
        {
          "command": "crewforge.continueConversation",
          "when": "view == crewforge.crews",
          "group": "navigation@2"
        },
        {
          "command": "crewforge.selectContext",
          "when": "view == crewforge.crews",
          "group": "navigation@3"
        },
        {
          "command": "crewforge.selectKubeconfig",
          "when": "view == crewforge.crews"
        },
        {
          "command": "crewforge.openConversationsFolder",
          "when": "view == crewforge.crews"
        },
        {
          "command": "crewforge.refreshSources",
          "when": "view == crewforge.sources",
          "group": "navigation@1"
        },
        {
          "command": "crewforge.createCrew",
          "when": "view == crewforge.sources",
          "group": "navigation@0"
        },
        {
          "command": "crewforge.createCrew",
          "when": "view == crewforge.crews",
          "group": "navigation@0"
        },
        {
          "command": "crewforge.openCrewsOverview",
          "when": "view == crewforge.crews",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "crewforge.deployDev",
          "when": "view == crewforge.sources && viewItem =~ /^source-(helm|bundle)(-running)?$/",
          "group": "inline@1"
        },
        {
          "command": "crewforge.redeployDev",
          "when": "view == crewforge.sources && viewItem =~ /^source-.*-changed/",
          "group": "inline@1"
        },
        {
          "command": "crewforge.askSource",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "inline@2"
        },
        {
          "command": "crewforge.deployDev",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "loop@1"
        },
        {
          "command": "crewforge.askSource",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "loop@2"
        },
        {
          "command": "crewforge.runFitness",
          "when": "view == crewforge.sources && viewItem =~ /^source-(?!.*-running$)/",
          "group": "loop@3"
        },
        {
          "command": "crewforge.lintCrew",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "loop@4"
        },
        {
          "command": "crewforge.askCrew",
          "when": "view == crewforge.crews && viewItem =~ /^crew(-flux)?(-running)?$/",
          "group": "inline"
        },
        {
          "command": "crewforge.showDrift",
          "when": "view == crewforge.sources && viewItem =~ /^resource-/",
          "group": "inline"
        },
        {
          "command": "crewforge.deploySource",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "deploy@1"
        },
        {
          "command": "crewforge.updateDeployment",
          "when": "view == crewforge.sources && viewItem =~ /^deployment-/",
          "group": "inline@1"
        },
        {
          "command": "crewforge.removeDeployment",
          "when": "view == crewforge.sources && viewItem =~ /^deployment-(helm|bundle)(-running)?$/",
          "group": "deploy@9"
        },
        {
          "command": "crewforge.applyResource",
          "when": "view == crewforge.sources && viewItem =~ /^resource-(changed|missing)$/",
          "group": "inline@2"
        },
        {
          "command": "crewforge.deployRevision",
          "when": "view == crewforge.sources && viewItem =~ /^deployment-/",
          "group": "deploy@2"
        },
        {
          "command": "crewforge.runFitness",
          "when": "view == crewforge.sources && viewItem == fitness",
          "group": "inline"
        },
        {
          "command": "crewforge.runFitness",
          "when": "view == crewforge.sources && viewItem =~ /^deployment-(?!.*-running$)/",
          "group": "deploy@3"
        },
        {
          "command": "crewforge.followRollout",
          "when": "view == crewforge.sources && viewItem =~ /^deployment-flux(-running)?$/",
          "group": "inline@2"
        },
        {
          "command": "crewforge.showLiveYaml",
          "when": "view == crewforge.crews && viewItem == liveObject",
          "group": "inline"
        },
        {
          "command": "crewforge.showLiveYaml",
          "when": "view == crewforge.crews && viewItem =~ /^crew(-flux)?(-running)?$/",
          "group": "yaml@1"
        },
        {
          "command": "crewforge.showCrewBundleYaml",
          "when": "view == crewforge.crews && viewItem =~ /^crew(-flux)?(-running)?$/",
          "group": "yaml@2"
        },
        {
          "command": "crewforge.updateDeployment",
          "when": "view == crewforge.crews && viewItem =~ /^crew(-flux)?(-running)?$/",
          "group": "lifecycle@1"
        },
        {
          "command": "crewforge.deployRevision",
          "when": "view == crewforge.crews && viewItem =~ /^crew(-flux)?(-running)?$/",
          "group": "lifecycle@2"
        },
        {
          "command": "crewforge.runFitness",
          "when": "view == crewforge.crews && viewItem =~ /^crew(-flux)?$/",
          "group": "lifecycle@3"
        },
        {
          "command": "crewforge.followRollout",
          "when": "view == crewforge.crews && viewItem =~ /^crew-flux(-running)?$/",
          "group": "lifecycle@4"
        },
        {
          "command": "crewforge.removeDeployment",
          "when": "view == crewforge.crews && viewItem =~ /^crew(-running)?$/",
          "group": "lifecycle@9"
        },
        {
          "command": "crewforge.showSourceYaml",
          "when": "view == crewforge.sources && viewItem =~ /^resource-/",
          "group": "yaml@1"
        },
        {
          "command": "crewforge.showLiveYaml",
          "when": "view == crewforge.sources && viewItem =~ /^resource-(in-sync|changed|extra)$/",
          "group": "yaml@2"
        },
        {
          "command": "crewforge.showLiveYamlRaw",
          "when": "view == crewforge.sources && viewItem =~ /^resource-(in-sync|changed|extra)$/",
          "group": "yaml@3"
        },
        {
          "command": "crewforge.showDrift",
          "when": "view == crewforge.sources && viewItem =~ /^resource-/",
          "group": "yaml@0"
        },
        {
          "command": "crewforge.showLiveYamlRaw",
          "when": "view == crewforge.crews && (viewItem == liveObject || viewItem =~ /^crew(-flux)?(-running)?$/)",
          "group": "yaml@3"
        },
        {
          "command": "crewforge.redeployDev",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "loop@1"
        },
        {
          "command": "crewforge.removeDeployment",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "deploy@9"
        },
        {
          "command": "crewforge.renameCrew",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "source@1"
        },
        {
          "command": "crewforge.deleteSource",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "source@9"
        },
        {
          "command": "crewforge.openCrewDashboard",
          "when": "view == crewforge.sources && viewItem =~ /^source-/",
          "group": "dashboard@0"
        },
        {
          "command": "crewforge.openCrewDashboard",
          "when": "view == crewforge.crews && viewItem =~ /^crew/",
          "group": "dashboard@0"
        },
        {
          "command": "crewforge.openFitnessDashboard",
          "when": "view == crewforge.sources && viewItem =~ /^(fitness|run)/",
          "group": "dashboard@1"
        },
        {
          "command": "crewforge.openFitnessDashboard",
          "when": "view == crewforge.crews && viewItem =~ /^crew/",
          "group": "dashboard@1"
        },
        {
          "command": "crewforge.addScenario",
          "when": "view == crewforge.sources && viewItem =~ /^(fitness|declSection-fitness)/",
          "group": "scenario@1"
        },
        {
          "command": "crewforge.addScenario",
          "when": "view == crewforge.sources && viewItem == declSection-fitness",
          "group": "inline"
        },
        {
          "command": "crewforge.runScenario",
          "when": "view == crewforge.sources && viewItem == declared-scenario",
          "group": "inline"
        },
        {
          "command": "crewforge.runScenario",
          "when": "view == crewforge.sources && viewItem == declared-scenario",
          "group": "scenario@1"
        },
        {
          "command": "crewforge.renameScenario",
          "when": "view == crewforge.sources && viewItem == declared-scenario",
          "group": "scenario@2"
        },
        {
          "command": "crewforge.deleteScenario",
          "when": "view == crewforge.sources && viewItem == declared-scenario",
          "group": "scenario@9"
        }
      ],
      "editor/context": [
        {
          "command": "crewforge.askAboutSelection",
          "when": "editorHasSelection",
          "group": "crewforge@1"
        }
      ],
      "commandPalette": [
        {
          "command": "crewforge.exportConversation",
          "when": "activeWebviewPanelId == crewforge.chat"
        },
        {
          "command": "crewforge.askAboutSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "crewforge.showDrift",
          "when": "false"
        },
        {
          "command": "crewforge.updateDeployment",
          "when": "false"
        },
        {
          "command": "crewforge.applyResource",
          "when": "false"
        },
        {
          "command": "crewforge.removeDeployment",
          "when": "false"
        },
        {
          "command": "crewforge.deployRevision",
          "when": "false"
        },
        {
          "command": "crewforge.runFitness",
          "when": "false"
        },
        {
          "command": "crewforge.showRun",
          "when": "false"
        },
        {
          "command": "crewforge.followRollout",
          "when": "false"
        },
        {
          "command": "crewforge.showLiveYaml",
          "when": "false"
        },
        {
          "command": "crewforge.showCrewBundleYaml",
          "when": "false"
        },
        {
          "command": "crewforge.newCrewHere",
          "when": "false"
        },
        {
          "command": "crewforge.showSourceYaml",
          "when": "false"
        },
        {
          "command": "crewforge.showLiveYamlRaw",
          "when": "false"
        },
        {
          "command": "crewforge.deleteSource",
          "when": "false"
        },
        {
          "command": "crewforge.renameCrew",
          "when": "false"
        },
        {
          "command": "crewforge.openCrewDashboard",
          "when": "false"
        },
        {
          "command": "crewforge.openFitnessDashboard",
          "when": "false"
        },
        {
          "command": "crewforge.addScenario",
          "when": "false"
        },
        {
          "command": "crewforge.renameScenario",
          "when": "false"
        },
        {
          "command": "crewforge.deleteScenario",
          "when": "false"
        },
        {
          "command": "crewforge.runScenario",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "crewforge.newCrewHere",
          "when": "explorerResourceIsFolder",
          "group": "crewforge@1"
        }
      ],
      "editor/title": [
        {
          "command": "crewforge.showSourceYaml",
          "when": "resourceScheme == crewforge-manifest && resourcePath =~ /^\\/(live|source)\\//",
          "group": "navigation@1"
        },
        {
          "command": "crewforge.showLiveYaml",
          "when": "resourceScheme == crewforge-manifest",
          "group": "navigation@2"
        },
        {
          "command": "crewforge.showLiveYamlRaw",
          "when": "resourceScheme == crewforge-manifest || (resourceScheme == crewforge-live && resourceFilename =~ /^(?!.*\\.(raw|bundle)\\.yaml$).*\\.yaml$/)",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "CrewForge",
      "properties": {
        "crewforge.kubeconfig": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a kubeconfig file. Empty uses `KUBECONFIG`, then `~/.kube/config`."
        },
        "crewforge.context": {
          "type": "string",
          "default": "",
          "description": "Kubernetes context to use. Empty uses the kubeconfig's current context."
        },
        "crewforge.namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Show crews only in these namespaces. Empty shows every namespace you can read."
        },
        "crewforge.streamTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 60,
          "description": "Longest a single turn may stream before CrewForge gives up on it."
        },
        "crewforge.dashboardUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL of the Kubemoot dashboard for this cluster, opened from **Powered by Kubemoot** in a chat and from **Open this turn in the Kubemoot dashboard** under a crew's answer (shown only when this is set). With a `kubectl port-forward` to the dashboard service, use its local address, for example `http://localhost:8080/dashboard`."
        },
        "crewforge.dashboardService": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Kubemoot dashboard's Service, as `namespace/name:port`, which the crew and fitness dashboards read through the Kubernetes service proxy (read-only) for thread counts, discussion failures, fitness scores, and archived iterations. Empty finds the Service labelled `app.kubernetes.io/name=kubemoot-dashboard`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node esbuild.mjs --integration && node .vscode-test/out/runTest.js"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "ajv": "^8.20.0",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.95.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "mocha": "^12.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
